  "proStatusSuccess": "Purchase successful — ads removed!",
  "@proStatusSuccess": {
    "description": "Feedback shown when a new purchase completes successfully."
  },
  "proStatusRestored": "Purchase restored — ads removed!",
  "@proStatusRestored": {
    "description": "Feedback shown when Restore purchases finds and reinstates a previous purchase."
  },
  "proStatusCancelled": "Purchase cancelled.",
  "@proStatusCancelled": {
    "description": "Feedback shown when the user cancels the purchase flow (e.g. dismisses the OS payment sheet)."
  },
  "proStatusError": "Something went wrong with the purchase. Please try again.",
  "@proStatusError": {
    "description": "Feedback shown when a purchase or restore attempt fails for any reason (network, store unavailable, product misconfigured)."
  },
  "proStatusRestoreNotFound": "No previous purchase found.",
  "@proStatusRestoreNotFound": {
    "description": "Feedback shown when Restore purchases finds nothing to restore."
  },
  "exportMatchButton": "Export match result",
