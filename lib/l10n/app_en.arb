{
  "@@locale": "en",
  "appTitle": "Table Tennis Scoreboard",
  "@appTitle": {
    "description": "The application's title, shown in the OS task switcher."
  },
  "newMatchScreenTitle": "New match",
  "@newMatchScreenTitle": {
    "description": "App bar title on the match-setup screen."
  },
  "languageMenuTooltip": "Language",
  "@languageMenuTooltip": {
    "description": "Tooltip on the language-picker icon button."
  },
  "languageSystemOption": "System default",
  "@languageSystemOption": {
    "description": "Language-picker option that follows the device's own language setting rather than overriding it."
  },
  "bestOfLabel": "Best of",
  "@bestOfLabel": {
    "description": "Label above the best-of-N game-count selector."
  },
  "bestOfSegmentLabel": "{bestOf}",
  "@bestOfSegmentLabel": {
    "description": "Label for one segment of the best-of-N selector — always a bare number, paired with the explanatory word in bestOfLabel above it (the same structural pattern in all three languages). English/French show the raw best-of-N number; German shows the number of *winning* games needed instead (paired with the \"Gewinnsätze\" heading), which is how German table tennis sources describe match format, e.g. \"3 Gewinnsätze im Einzel\" for what this app calls best-of-5 — see PHASE3_VERIFICATION.md and PHASE4B_UI_POLISH.md (the word used to live inside this segment label itself, which is what caused it to overflow only for German).",
    "placeholders": {
      "bestOf": {
        "type": "int",
        "example": "5"
      },
      "gamesToWin": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "tossPrompt": "Toss to decide who serves first",
  "@tossPrompt": {
    "description": "Shown before the coin toss has been used to pick the first server."
  },
  "firstServerLabel": "First server: {player}",
  "@firstServerLabel": {
    "description": "Shown after the coin toss, naming who serves first.",
    "placeholders": {
      "player": {
        "type": "String",
        "example": "Player 1"
      }
    }
  },
  "tossButton": "Toss coin",
  "@tossButton": {
    "description": "Button that randomly picks the first server."
  },
  "startMatchButton": "Start match",
  "@startMatchButton": {
    "description": "Button that begins the match with the chosen settings."
  },
  "scoreboardTitle": "Table Tennis",
  "@scoreboardTitle": {
    "description": "App bar title on the live scoreboard screen."
  },
  "muteTooltip": "Mute voice",
  "@muteTooltip": {
    "description": "Tooltip on the mute button when voice announcements are currently on."
  },
  "unmuteTooltip": "Unmute voice",
  "@unmuteTooltip": {
    "description": "Tooltip on the mute button when voice announcements are currently muted."
  },
  "undoTooltip": "Undo",
  "@undoTooltip": {
    "description": "Tooltip on the undo-last-point button."
  },
  "resetTooltip": "Reset match",
  "@resetTooltip": {
    "description": "Tooltip on the reset-match button."
  },
  "servingTooltip": "Serving",
  "@servingTooltip": {
    "description": "Accessibility label on the icon that marks which player is currently serving."
  },
  "player1Label": "Player 1",
  "@player1Label": {
    "description": "Display name for the first player."
  },
  "player2Label": "Player 2",
  "@player2Label": {
    "description": "Display name for the second player."
  },
  "player3Label": "Player 3",
  "@player3Label": {
    "description": "Display name for the third player (doubles only)."
  },
  "player4Label": "Player 4",
  "@player4Label": {
    "description": "Display name for the fourth player (doubles only)."
  },
  "team1Label": "Team 1",
  "@team1Label": {
    "description": "Side-level display name for the first side in doubles — used for the toss result and game/match-complete banners, where 'Player 1' would be ambiguous about whether it means one specific individual or the whole side. Not used for the four individual on-court player labels, which stay Player 1-4."
  },
  "team2Label": "Team 2",
  "@team2Label": {
    "description": "Side-level display name for the second side in doubles — see team1Label."
  },
  "receivingTooltip": "Receiving",
  "@receivingTooltip": {
    "description": "Accessibility label on the icon that marks which player is currently receiving serve (doubles only)."
  },
  "modeSinglesOption": "Singles",
  "@modeSinglesOption": {
    "description": "Singles/doubles mode selector option for a 2-player match."
  },
  "modeDoublesOption": "Doubles",
  "@modeDoublesOption": {
    "description": "Singles/doubles mode selector option for a 4-player match."
  },
  "gamesCountLabel": "Games: {count}",
  "@gamesCountLabel": {
    "description": "Shows how many games a player has won so far in the match.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "changeEndsSnackBar": "Change ends",
  "@changeEndsSnackBar": {
    "description": "Snackbar shown mid-game, in the deciding game, when a player reaches 5 points (ITTF Law 2.14.2)."
  },
  "gameCompleteMessage": "{player} wins the game — change ends",
  "@gameCompleteMessage": {
    "description": "Snackbar shown when a game is won.",
    "placeholders": {
      "player": {
        "type": "String",
        "example": "Player 1"
      }
    }
  },
  "matchCompleteDialogTitle": "Match complete",
  "@matchCompleteDialogTitle": {
    "description": "Title of the dialog shown when the match ends."
  },
  "matchCompleteMessage": "{player} wins the match!",
  "@matchCompleteMessage": {
    "description": "Body text of the dialog shown when the match ends.",
    "placeholders": {
      "player": {
        "type": "String",
        "example": "Player 1"
      }
    }
  },
  "newMatchButton": "New match",
  "@newMatchButton": {
    "description": "Button on the match-complete dialog that starts a fresh match."
  },
  "matchStartCheer": "Let's Play!",
  "@matchStartCheer": {
    "description": "Energetic, centered on-screen phrase shown during the brief ball-flyby transition between tapping \"Start match\" and landing on the scoreboard — see PHASE4E_MATCH_START_TRANSITION.md. Deliberately casual/energetic copy, not official rules terminology."
  },
  "editNameHint": "Tap to rename",
  "@editNameHint": {
    "description": "Tooltip/accessibility hint on a player or team name that can be tapped to rename it for the current match — see PHASE4F_THEME_AND_NAMES.md."
  },
  "themeMenuTooltip": "Theme",
  "@themeMenuTooltip": {
    "description": "Tooltip on the light/dark/system theme picker icon button."
  },
  "themeSystemOption": "System default",
  "@themeSystemOption": {
    "description": "Theme-picker option that follows the device's own light/dark setting rather than overriding it."
  },
  "themeLightOption": "Light",
  "@themeLightOption": {
    "description": "Theme-picker option that forces the light theme."
  },
  "themeDarkOption": "Dark",
  "@themeDarkOption": {
    "description": "Theme-picker option that forces the dark theme."
  },
  "proMenuTooltip": "Remove Ads / Pro",
  "@proMenuTooltip": {
    "description": "Tooltip on the app-bar icon that opens the Pro purchase dialog."
  },
  "proDialogTitle": "Remove Ads / Pro",
  "@proDialogTitle": {
    "description": "Title of the Pro purchase dialog."
  },
  "proDialogDescriptionFree": "A one-time purchase that removes ads and unlocks exporting your match results.",
  "@proDialogDescriptionFree": {
    "description": "Body text shown in the Pro dialog when the user has not purchased Pro yet."
  },
  "proDialogAlreadyProTitle": "You're Pro!",
  "@proDialogAlreadyProTitle": {
    "description": "Heading shown in the Pro dialog once the user already owns Pro."
  },
  "proDialogAlreadyProBody": "Ads are removed and match export is unlocked. Thanks for your support!",
  "@proDialogAlreadyProBody": {
    "description": "Body text shown in the Pro dialog once the user already owns Pro."
  },
  "proBuyButton": "Remove Ads (One-Time Purchase)",
  "@proBuyButton": {
    "description": "Button that starts the Pro purchase flow. Deliberately has no price baked in — the OS purchase sheet shows the real, store-localized price; see PHASE5_MONETIZATION.md for the target ~€2.99 price to configure in Play Console."
  },
  "proRestoreButton": "Restore purchases",
  "@proRestoreButton": {
    "description": "Button that re-queries the store for a previous purchase (required by store policy, and essential after a reinstall or device switch)."
  },
  "proStatusPending": "Purchase pending…",
  "@proStatusPending": {
    "description": "Feedback shown while a purchase is pending (e.g. awaiting parental approval or slow network)."
  },
  "proStatusSuccess": "Purchase successful — ads removed!",
  "@proStatusSuccess": {
    "description": "Feedback shown when a new purchase completes successfully."
  },
  "proStatusRestored": "Purchase restored — ads removed!",
  "@proStatusRestored": {
    "description": "Feedback shown when Restore purchases finds and reinstates a previous purchase."
  },
  "proStatusCancelled": "Purchase cancelled.",
  "@proStatusCancelled": {
    "description": "Feedback shown when the user cancels the purchase flow (e.g. dismisses the OS payment sheet)."
  },
  "proStatusError": "Something went wrong with the purchase. Please try again.",
  "@proStatusError": {
    "description": "Feedback shown when a purchase or restore attempt fails for any reason (network, store unavailable, product misconfigured)."
  },
  "proStatusRestoreNotFound": "No previous purchase found.",
  "@proStatusRestoreNotFound": {
    "description": "Feedback shown when Restore purchases finds nothing to restore."
  },
  "exportMatchButton": "Export match result",
  "@exportMatchButton": {
    "description": "Pro-only button on the match-complete dialog that copies a plain-text summary of the match to the clipboard."
  },
  "exportMatchCopied": "Match result copied to clipboard",
  "@exportMatchCopied": {
    "description": "Confirmation shown after exportMatchButton is tapped."
  },
  "exportGameLine": "Game {number}: {player1Points}-{player2Points}",
  "@exportGameLine": {
    "description": "One line per completed game in the exported match-result text.",
    "placeholders": {
      "number": {
        "type": "int"
      },
      "player1Points": {
        "type": "int"
      },
      "player2Points": {
        "type": "int"
      }
    }
  }
}
