{
  "@@locale": "en",
  "appTitle": "Table Tennis Scoreboard",
  "@appTitle": {
    "description": "The application's title, shown in the OS task switcher."
  },
  "newMatchScreenTitle": "New match",
  "@newMatchScreenTitle": {
    "description": "App bar title on the match-setup screen."
  },
  "moreOptionsTooltip": "More options",
  "@moreOptionsTooltip": {
    "description": "Tooltip on the app-bar overflow (three-dot) icon that opens the consolidated theme/language/Pro menu — see PHASE4I_POLISH_ROUND2.md."
  },
  "languageMenuTooltip": "Language",
  "@languageMenuTooltip": {
    "description": "Section label for the language options within the app-bar overflow menu (Phase 4I) — previously this was its own icon button's tooltip, before the theme/language/Pro icons were consolidated into one menu."
  },
  "languageAutomatic": "Automatic ({language})",
  "@languageAutomatic": {
    "description": "Language-picker option that follows the device's own language setting rather than overriding it. The placeholder is the language that setting currently resolves to, written in that language itself (English, Deutsch, Français) — only the word \"Automatic\" is translated.",
    "placeholders": {
      "language": {
        "type": "String",
        "example": "English"
      }
    }
  },
  "bestOfLabel": "Best of",
  "@bestOfLabel": {
    "description": "Label above the best-of-N game-count selector."
  },
  "bestOfSegmentLabel": "{bestOf}",
  "@bestOfSegmentLabel": {
    "description": "Label for one segment of the best-of-N selector — always a bare number, paired with the explanatory word in bestOfLabel above it (the same structural pattern in all three languages). English/French show the raw best-of-N number; German shows the number of *winning* games needed instead (paired with the \"Gewinnsätze\" heading), which is how German table tennis sources describe match format, e.g. \"3 Gewinnsätze im Einzel\" for what this app calls best-of-5 — see PHASE3_VERIFICATION.md and PHASE4B_UI_POLISH.md (the word used to live inside this segment label itself, which is what caused it to overflow only for German).",
    "placeholders": {
      "bestOf": {
        "type": "int",
        "example": "5"
      },
      "gamesToWin": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "tossPrompt": "Toss to decide who serves first",
  "@tossPrompt": {
    "description": "Shown before the coin toss has been used to pick the first server."
  },
  "firstServerLabel": "First server: {player}",
  "@firstServerLabel": {
    "description": "Shown after the coin toss, naming who serves first.",
    "placeholders": {
      "player": {
        "type": "String",
        "example": "Player 1"
      }
    }
  },
  "tapToTossLabel": "Tap to toss",
  "@tapToTossLabel": {
    "description": "Shown on the coin's idle face, inviting the first tap — the coin itself is the only toss control, there is no separate button. Must always fit on a single line at the coin's actual rendered size (enforced by a FittedBox, verified by a dedicated test) — see PHASE4P_PREMIUM_VISUAL_AND_MOTION_PASS.md."
  },
  "startMatchButton": "Start match",
  "@startMatchButton": {
    "description": "Button that begins the match with the chosen settings."
  },
  "scoreboardTitle": "Table Tennis",
  "@scoreboardTitle": {
    "description": "App bar title on the live scoreboard screen."
  },
  "muteTooltip": "Mute voice",
  "@muteTooltip": {
    "description": "Tooltip on the mute button when voice announcements are currently on."
  },
  "unmuteTooltip": "Unmute voice",
  "@unmuteTooltip": {
    "description": "Tooltip on the mute button when voice announcements are currently muted."
  },
  "undoTooltip": "Undo",
  "@undoTooltip": {
    "description": "Tooltip on the undo-last-point button."
  },
  "resetTooltip": "Reset match",
  "@resetTooltip": {
    "description": "Tooltip on the reset-match button."
  },
  "servingTooltip": "Serving",
  "@servingTooltip": {
    "description": "Accessibility label on the icon that marks which player is currently serving."
  },
  "player1Label": "Player 1",
  "@player1Label": {
    "description": "Display name for the first player."
  },
  "player2Label": "Player 2",
  "@player2Label": {
    "description": "Display name for the second player."
  },
  "player3Label": "Player 3",
  "@player3Label": {
    "description": "Display name for the third player (doubles only)."
  },
  "player4Label": "Player 4",
  "@player4Label": {
    "description": "Display name for the fourth player (doubles only)."
  },
  "team1Label": "Team 1",
  "@team1Label": {
    "description": "Side-level display name for the first side in doubles — used for the toss result and game/match-complete banners, where 'Player 1' would be ambiguous about whether it means one specific individual or the whole side. Not used for the four individual on-court player labels, which stay Player 1-4."
  },
  "team2Label": "Team 2",
  "@team2Label": {
    "description": "Side-level display name for the second side in doubles — see team1Label."
  },
  "receivingTooltip": "Receiving",
  "@receivingTooltip": {
    "description": "Accessibility label on the icon that marks which player is currently receiving serve (doubles only)."
  },
  "modeSinglesOption": "Singles",
  "@modeSinglesOption": {
    "description": "Singles/doubles mode selector option for a 2-player match."
  },
  "modeDoublesOption": "Doubles",
  "@modeDoublesOption": {
    "description": "Singles/doubles mode selector option for a 4-player match."
  },
  "gamesCountLabel": "Games: {count}",
  "@gamesCountLabel": {
    "description": "Shows how many games a player has won so far in the match.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "changeEndsSnackBar": "Change ends",
  "@changeEndsSnackBar": {
    "description": "Snackbar shown mid-game, in the deciding game, when a player reaches 5 points (ITTF Law 2.14.2)."
  },
  "gameCompleteMessage": "{player} wins the game — change ends",
  "@gameCompleteMessage": {
    "description": "Snackbar shown when a game is won.",
    "placeholders": {
      "player": {
        "type": "String",
        "example": "Player 1"
      }
    }
  },
  "matchCompleteDialogTitle": "Match complete",
  "@matchCompleteDialogTitle": {
    "description": "Title of the dialog shown when the match ends."
  },
  "matchCompleteMessage": "{player} wins the match!",
  "@matchCompleteMessage": {
    "description": "Body text of the dialog shown when the match ends.",
    "placeholders": {
      "player": {
        "type": "String",
        "example": "Player 1"
      }
    }
  },
  "newMatchButton": "New match",
  "@newMatchButton": {
    "description": "Button on the match-complete dialog that starts a fresh match."
  },
  "matchStartCheer": "Let's Play!",
  "@matchStartCheer": {
    "description": "Energetic, centered on-screen phrase shown during the brief ball-flyby transition between tapping \"Start match\" and landing on the scoreboard — see PHASE4E_MATCH_START_TRANSITION.md. Deliberately casual/energetic copy, not official rules terminology."
  },
  "editNameHint": "Tap to rename",
  "@editNameHint": {
    "description": "Tooltip/accessibility hint on a player or team name that can be tapped to rename it for the current match — see PHASE4F_THEME_AND_NAMES.md."
  },
  "themeMenuTooltip": "Theme",
  "@themeMenuTooltip": {
    "description": "Section label for the theme options within the app-bar overflow menu (Phase 4I) — previously this was its own icon button's tooltip, before the theme/language/Pro icons were consolidated into one menu."
  },
