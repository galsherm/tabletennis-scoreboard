  "@proDialogDescriptionFree": {
    "description": "Body text shown in the Pro dialog when the user has not purchased Pro yet."
  },
  "proDialogAlreadyProTitle": "You're Pro!",
  "@proDialogAlreadyProTitle": {
    "description": "Heading shown in the Pro dialog once the user already owns Pro."
